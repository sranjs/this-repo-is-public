        "transformationSQL" : true,
        "sqlStatements" : {
          "ETL_FACT_ORDERS_SQL" : [ {
            "sql" : "SELECT \n    o.order_id AS order_id,\n    CAST(o.order_date AS DATE) AS order_date,\n    CAST(o.ship_date AS DATE) AS ship_date,\n    ROUND(o.subtotal * o.tax_rate, 2) AS tax_amount,\n    UPPER(REPLACE(o.payment_method, '_', ' ')) AS payment_type,\n    CASE WHEN o.notes IS NOT NULL THEN 1 ELSE 0 END AS has_notes,\n    YEAR(o.order_date) AS order_year,\n    CONCAT(UPPER(LEFT(c.first_name, 1)), LOWER(SUBSTRING(c.first_name, 2)), ' ', UPPER(LEFT(c.last_name, 1)), LOWER(SUBSTRING(c.last_name, 2))) AS customer_full_name,\n    LOWER(c.email) AS customer_email,\n    CASE \n        WHEN c.loyalty_tier = 'bronze' THEN 1 \n        WHEN c.loyalty_tier = 'silver' THEN 2 \n        WHEN c.loyalty_tier = 'gold' THEN 3 \n        WHEN c.loyalty_tier = 'platinum' THEN 4 \n    END AS customer_tier_code,\n    DATEDIFF(o.ship_date, o.order_date) AS delivery_days,\n    CASE \n        WHEN o.status = 'delivered' THEN 'DLV' \n        WHEN o.status = 'processing' THEN 'PRC' \n        WHEN o.status = 'shipped' THEN 'SHP' \n        WHEN o.status = 'cancelled' THEN 'CAN' \n        ELSE 'PND' \n    END AS order_status_code,\n    IF(o.status = 'cancelled', 1, 0) AS is_cancelled,\n    ROUND(((o.subtotal * (1 + o.tax_rate)) - o.discount_amount + o.shipping_fee), 2) AS total_amount,\n    (SELECT COUNT(DISTINCT oi.item_id) FROM etl_order_items oi WHERE oi.order_id = o.order_id) AS item_count,\n    CASE \n        WHEN MONTH(o.order_date) BETWEEN 1 AND 3 THEN 'Q1' \n        WHEN MONTH(o.order_date) BETWEEN 4 AND 6 THEN 'Q2' \n        WHEN MONTH(o.order_date) BETWEEN 7 AND 9 THEN 'Q3' \n        ELSE 'Q4' \n    END AS order_quarter\nFROM etl_orders o\nJOIN etl_customers c ON o.cust_id = c.cust_id",
            "name" : "ETL_FACT_ORDERS_SQL"
          } ]
        },
