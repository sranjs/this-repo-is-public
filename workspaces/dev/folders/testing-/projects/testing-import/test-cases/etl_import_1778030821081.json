        "sqlStatements" : {
          "ETL_FACT_ORDERS_SQL" : [ {
            "sql" : "SELECT CAST(o.order_date AS DATE) AS order_date, CAST(o.ship_date AS DATE) AS ship_date, ROUND(o.subtotal * o.tax_rate, 2) AS tax_amount, UPPER(REPLACE(o.payment_method, '_', ' ')) AS payment_type, CASE WHEN o.notes IS NOT NULL THEN 1 ELSE 0 END AS has_notes, YEAR(o.order_date) AS order_year, CONCAT(UPPER(LEFT(c.first_name, 1)), LOWER(SUBSTRING(c.first_name, 2)), ' ', UPPER(LEFT(c.last_name, 1)), LOWER(SUBSTRING(c.last_name, 2))) AS customer_full_name, LOWER(c.email) AS customer_email, CASE WHEN c.loyalty_tier = 'bronze' THEN 1 WHEN c.loyalty_tier = 'silver' THEN 2 WHEN c.loyalty_tier = 'gold' THEN 3 WHEN c.loyalty_tier = 'platinum' THEN 4 END AS customer_tier_code, DATEDIFF(o.ship_date, o.order_date) AS delivery_days, CASE WHEN o.status = 'delivered' THEN 'DLV' WHEN o.status = 'processing' THEN 'PRC' WHEN o.status = 'shipped' THEN 'SHP' WHEN o.status = 'cancelled' THEN 'CAN' ELSE 'PND' END AS order_status_code, CASE WHEN o.status = 'cancelled' THEN 1 ELSE 0 END AS is_cancelled, ROUND(((o.subtotal * (1 + o.tax_rate)) - o.discount_amount) + o.shipping_fee, 2) AS total_amount, COUNT(DISTINCT oi.item_id) FROM etl_order_items oi WHERE oi.order_id = o.order_id` AS item_count, CASE WHEN MONTH(o.order_date) BETWEEN 1 AND 3 THEN 'Q1' WHEN MONTH(o.order_date) BETWEEN 4 AND 6 THEN 'Q2' WHEN MONTH(o.order_date) BETWEEN 7 AND 9 THEN 'Q3' ELSE 'Q4' END AS order_quarter, order_id FROM etl_orders",
            "name" : "ETL_FACT_ORDERS_SQL"
          } ]
